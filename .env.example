# ── Mẫu cấu hình. Copy thành .env.local (dev) hoặc khai trong Vercel (Sensitive). KHÔNG commit giá trị thật.

# Postgres. Dev: Postgres cục bộ (npm run db:local). Prod: Supabase.
#  - DATABASE_URL: pooler Supabase (port 6543) + pgbouncer=true
#  - DIRECT_URL: kết nối trực tiếp (port 5432) cho migration
#  - Luôn giữ schema=irhub để bảng KHÔNG nằm trong schema public (Data API không thấy)
DATABASE_URL="postgresql://postgres:irhub_local@127.0.0.1:54329/irhub?schema=irhub"
DIRECT_URL="postgresql://postgres:irhub_local@127.0.0.1:54329/irhub?schema=irhub"

# URL gốc của app (dùng làm redirect_uri OAuth)
APP_URL="http://localhost:3000"

# Khoá mã hoá dữ liệu nhạy cảm (CCCD, tài khoản ngân hàng). 32 byte base64.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Định dạng: "<keyId>:<base64>". Khi xoay khoá, đưa khoá cũ vào DATA_KEYS_PREVIOUS (phân tách bằng dấu phẩy).
DATA_KEY=""
DATA_KEYS_PREVIOUS=""

# Bí mật HMAC cho mã OTP và hash chain audit (32 byte base64)
AUTH_PEPPER=""

# Google Workspace (OIDC) — chỉ chấp nhận tài khoản thuộc domain này
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAIN="appota.com"

# Lark Suite (OAuth) — chỉ chấp nhận user thuộc tenant Appota
LARK_APP_ID=""
LARK_APP_SECRET=""
LARK_TENANT_KEY=""
LARK_ACCOUNTS_BASE="https://accounts.larksuite.com"
LARK_OPEN_BASE="https://open.larksuite.com"

# Gửi email OTP. "console" = in ra log (chỉ dev). Prod: "resend".
MAIL_DRIVER="console"
RESEND_API_KEY=""
MAIL_FROM="IR Appota <ir@appota.com>"

# Lưu file. "local" = thư mục ngoài repo (dev). Prod: "supabase" (bucket private).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="irhub-private"

# Đăng nhập nhanh cho dev. Bị chặn cứng khi NODE_ENV=production.
ALLOW_DEV_LOGIN="false"
